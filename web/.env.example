# Copy to .env.local for local work; on Vercel set these in Project Settings -> Environment Variables.
SITE_URL=https://your-domain.com          # canonical origin used in sitemap, canonical tags, OG images
GROQ_API_KEY=                             # optional: enables live Groq discovery and calls
GEMINI_API_KEY=                           # optional: enables live Gemini discovery and calls
DAILY_BUDGET_USD=1.0
RATE_LIMIT_RPM=60
ALLOW_CHAOS=false
RESEND_API_KEY=                           # optional: contact form delivery
CONTACT_TO_EMAIL=                         # where contact messages go
