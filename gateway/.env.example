# Copy to .env (never commit it). With no keys the gateway runs on the offline mock provider.
GROQ_API_KEY=
GEMINI_API_KEY=
MOCK_MODE=            # blank = auto (mock unless a key is set); true/false to force
GATEWAY_API_KEY=      # when set, every request needs the X-API-Key header
DAILY_BUDGET_USD=1.0
RATE_LIMIT_RPM=60
ALLOW_CHAOS=true      # honour X-Chaos-Simulate; set false in production
REDIS_URL=            # blank = in-memory cache
DB_PATH=gateway.db
